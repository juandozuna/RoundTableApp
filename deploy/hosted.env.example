# Gold Roundtables — hosted deployment settings.
#
#   cp deploy/hosted.env.example deploy/hosted.env     # git-ignored; never commit the copy
#   $EDITOR deploy/hosted.env
#   bash scripts/deploy-hosted.sh --dry-run
#
# Read by scripts/deploy-hosted.sh, scripts/setup-powersync-replication.sh --hosted,
# scripts/build-web.sh and scripts/smoke-hosted.sh. The file is sourced by bash: quote values that
# contain spaces or shell characters. Never read: the local `.env` (local stack values must not leak
# into a hosted build).
#
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD and SUPABASE_DB_URL taken from the shell environment
# win over this file, so you can keep them out of it:
#   export SUPABASE_ACCESS_TOKEN=sbp_…   (supabase.com → Account → Access Tokens)
# Values below that are shown empty are optional unless the comment says "required".

# ── Supabase project ────────────────────────────────────────────────────────────────────────
# required. The 20-letter id in the dashboard URL: supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=

# Personal access token for the Supabase CLI / Management API. Prefer exporting it in the shell
# (or `supabase login`) instead of writing it here. Never echoed by the scripts.
#SUPABASE_ACCESS_TOKEN=

# required for `supabase db push` and `supabase link`. The database password chosen when the
# project was created (Dashboard → Project Settings → Database → Reset database password).
#SUPABASE_DB_PASSWORD=

# Optional. Postgres connection string used instead of the linked project for SQL steps
# (Vault secrets, first admin, replication role). Must be percent-encoded. Direct connection is
# IPv6-only unless the IPv4 add-on is enabled; the session pooler (port 5432) works over IPv4.
#SUPABASE_DB_URL=postgresql://postgres.<ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional. API URL; defaults to https://<SUPABASE_PROJECT_REF>.supabase.co. Set it only with a
# custom domain.
#SUPABASE_URL=

# Public "anon" (or publishable) key, compiled into the web/mobile build. Public by design; NEVER the
# service-role / secret key (scripts/build-web.sh refuses it). Dashboard → Project Settings → API.
# If empty, scripts/build-web.sh tries `supabase projects api-keys`.
SUPABASE_ANON_KEY=

# ── Edge Function secrets (pushed with `supabase secrets set`) ───────────────────────────────
# required. Public https URL of the web app, no trailing slash. Invite links are
# <APP_PUBLIC_URL>/invite/<CODE>. Also the Auth site URL (see the checklist the deploy prints).
APP_PUBLIC_URL=

# required. Comma-separated CORS origins of the web app, e.g. https://app.example.org. "*" is
# refused here. Add the Cloudflare preview host too if you test previews against production.
ALLOWED_ORIGINS=

# required. Shared secret for pg_cron → notifications function (header x-cron-secret). At least 32
# characters from A-Z a-z 0-9 . _ ~ + = - ; generate with:  openssl rand -hex 32
# Also stored in Supabase Vault as `cron_secret` by the deploy script.
CRON_SECRET=

# Optional. Path to the Firebase service-account key (JSON file) for FCM HTTP v1, created in
# Firebase console → Project settings → Service accounts → Generate new private key (project
# roundtable-v1). Keep it outside the repo or under deploy/ (git-ignored). Empty: push is skipped.
FCM_SERVICE_ACCOUNT_FILE=

# ── Vault (read by the cron job app.dispatch_notifications_http) ───────────────────────────
# Written by deploy-hosted.sh as Vault secrets `functions_base_url` (=<SUPABASE_URL>/functions/v1)
# and `cron_secret` (=CRON_SECRET). Nothing to set here.

# ── First platform administrator (optional; no demo data in hosted) ─────────────────────────
# The person must have signed in once with this email (the app says "No encontramos tu cuenta"),
# then run:  bash scripts/deploy-hosted.sh --only admin
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_FIRST_NAME=
FIRST_ADMIN_LAST_NAME=

# ── PowerSync ───────────────────────────────────────────────────────────────────────────────
# required for the web build. Public https URL of the PowerSync instance as the BROWSER reaches it
# (PowerSync Cloud: https://<instance-id>.powersync.journeyapps.com).
POWERSYNC_URL=

# Password of the replication role `powersync_role` created by
# `scripts/setup-powersync-replication.sh --hosted`. Letters, digits, `_`, `.`, `-` only.
# Generate with: openssl rand -hex 24
POWERSYNC_DB_PASSWORD=

# Reference only (paste it into PowerSync): https://<SUPABASE_PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json

# ── Web build (--dart-define values; scripts/build-web.sh) ──────────────────────────────────
# DEV_AUTH is always compiled as false in hosted builds; the build fails if it is set to true here.
# local | staging | production
APP_ENV=production
# Optional HTTP endpoint receiving scrubbed client error reports (docs/operations.md §1).
ERROR_REPORT_URL=

# Firebase web app config for push (Firebase console → Project settings → Your apps → Web app).
# Project roundtable-v1, sender id 1050044136194. All of API key, app id, sender id and project id
# are needed; empty disables web push. The VAPID key is Cloud Messaging → Web Push certificates.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=1050044136194
FIREBASE_PROJECT_ID=roundtable-v1
FIREBASE_VAPID_KEY=

# ── Functions bundling ──────────────────────────────────────────────────────────────────────
# true (default): the CLI bundles functions server-side (`--use-api`), no Docker needed.
# false: bundle with the local Docker daemon.
FUNCTIONS_USE_API=true
