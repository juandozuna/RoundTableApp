# Gold Roundtables — local stack and deployment variables.
# Copy to `.env` (git-ignored) to override defaults; every value below is optional locally.
# Read by docker-compose.yml and scripts/*.sh. The Supabase local demo keys are NOT set here:
# scripts read them from `supabase status -o env`.

# ── Local stack ─────────────────────────────────────────────────────────────────────────────
# Supabase CLI project id (supabase/config.toml). The database container is supabase_db_<id>.
SUPABASE_PROJECT_ID=gold-roundtables
# Host where PowerSync's container reaches the Supabase stack. `host.docker.internal` works on
# Docker Desktop (macOS/Windows) and, via extra_hosts, on Linux. Alternative: 172.17.0.1.
DOCKER_HOST_ALIAS=host.docker.internal
SUPABASE_DB_PORT=54322
SUPABASE_API_PORT=54321
# JWKS used by PowerSync to validate Supabase user tokens (ES256, audience `authenticated`).
POWERSYNC_JWKS_URI=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# Passwords of the local replication role (created on the Supabase DB by
# scripts/setup-powersync-replication.sh) and of PowerSync's own storage Postgres.
# Letters, digits, `_`, `.`, `-` only.
POWERSYNC_DB_PASSWORD=powersync_local_dev
POWERSYNC_STORAGE_PASSWORD=powersync_storage_local_dev
# PowerSync Service image tag (>= 1.20 is required for Sync Streams) and log level.
POWERSYNC_SERVICE_VERSION=1.27
POWERSYNC_LOG_LEVEL=info
POWERSYNC_PORT=8080
WEB_PORT=3000
# How scripts/dev-up.sh builds the web app: `docker` (docker/web/Dockerfile, no Flutter on the host)
# or `local` (host Flutter, faster rebuilds; scripts/web-dev-serve.sh).
WEB_MODE=docker
# Flutter version of the Docker build image (ghcr.io/cirruslabs/flutter).
FLUTTER_VERSION=3.41.1

# ── Flutter --dart-define values (compiled into the web build) ─────────────────────────────
# SUPABASE_URL / SUPABASE_ANON_KEY default to `supabase status -o env`. Set them to target a
# hosted Supabase project. The anon key is public; never put the service-role key here.
#SUPABASE_URL=http://127.0.0.1:54321
#SUPABASE_ANON_KEY=
# URLs as seen by the BROWSER (not by containers).
POWERSYNC_URL=http://127.0.0.1:8080
# Compiles the email+password dev sign-in. Local testing only — must be false/absent in production.
DEV_AUTH=true
# local | staging | production
APP_ENV=local
# Optional Firebase web config for push (FCM); empty disables web push.
#FIREBASE_API_KEY=
#FIREBASE_APP_ID=
#FIREBASE_MESSAGING_SENDER_ID=
#FIREBASE_PROJECT_ID=
#FIREBASE_VAPID_KEY=

# ── Supabase Edge Functions (copy to supabase/functions/.env, or set as hosted secrets) ─────
# Public URL of the web app; invite links are <APP_PUBLIC_URL>/invite/<CODE>.
APP_PUBLIC_URL=http://127.0.0.1:3000
# Comma-separated CORS origins, e.g. https://app.example.org,http://127.0.0.1:3000. `*` is local only.
ALLOWED_ORIGINS=*
# Shared secret for pg_cron / schedulers calling /notifications/dispatch and /notifications/cron/*
# (header x-cron-secret). Use a long random value outside local development.
CRON_SECRET=change-me-local-cron-secret
# Firebase service account JSON on ONE line (FCM HTTP v1). Empty locally: notifications no-op.
FCM_SERVICE_ACCOUNT_JSON=

# ── Social sign-in (supabase/config.toml reads these via env(...); export them or put them in
#    supabase/.env before `supabase start`; the providers stay `enabled = false` until you flip
#    them in config.toml). Never commit real values.
#SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
#SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
#SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
#SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
#SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
#SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
